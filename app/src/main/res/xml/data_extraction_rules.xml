<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- El PIN y datos de bloqueo viven en EncryptedSharedPreferences y NO se
             respaldan (dependen del Keystore, que no se transfiere entre equipos). -->
        <exclude domain="sharedpref" path="cuentasclaras_lock.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cuentasclaras_lock.xml" />
    </device-transfer>
</data-extraction-rules>
