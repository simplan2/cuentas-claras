# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# --- kotlinx.serialization ---
-keepattributes *Annotation*, InnerClasses, Signature, RuntimeVisibleAnnotations
-dontnote kotlinx.serialization.**

# Generated serializers
-keepclassmembers class **$$serializer {
    *;
}
-keepclasseswithmembers class com.simplan.cuentasclaras.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# Domain entity models used for backup payload (de)serialization
-keep class com.simplan.cuentasclaras.domain.entity.** { *; }
-keep,includedescriptorclasses class com.simplan.cuentasclaras.domain.entity.**$$serializer { *; }

# --- Tink / security-crypto (compile-only annotations not packaged) ---
-dontwarn com.google.errorprone.annotations.**
